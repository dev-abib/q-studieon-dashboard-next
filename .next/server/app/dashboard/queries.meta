{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/queries/layout,_N_T_/dashboard/queries/page,_N_T_/dashboard/queries"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/queries/__PAGE__",
    "/dashboard/queries",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}