{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/dynamic-page/layout,_N_T_/dashboard/dynamic-page/page,_N_T_/dashboard/dynamic-page"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/dynamic-page/__PAGE__",
    "/dashboard/dynamic-page",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}